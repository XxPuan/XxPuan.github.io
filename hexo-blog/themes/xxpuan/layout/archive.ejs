<div class="page">
  <% if (page.archive) { %>
    <h1 class="page-title">归档</h1>
    <p class="page-sub">共 <%= page.posts.length %> 篇文章</p>
  <% } else if (page.tag) { %>
    <h1 class="page-title">标签：<%= page.tag %></h1>
    <p class="page-sub">共 <%= page.posts.length %> 篇文章</p>
  <% } else { %>
    <h1 class="page-title">所有文章</h1>
  <% } %>

  <div class="posts-list">
    <% page.posts.each(function(post) { %>
      <article class="post-card">
        <time class="post-date" datetime="<%= date(post.date, 'YYYY-MM-DD') %>">
          <%= date(post.date, 'YYYY 年 MM 月 DD 日') %>
        </time>
        <h2 class="post-title">
          <a href="./<%= post.path %>"><%= post.title %></a>
        </h2>
        <% if (post.tags && post.tags.length) { %>
          <div class="post-tags">
            <% post.tags.each(function(tag) { %>
              <a class="tag" href="./<%= tag.path %>"><%= tag.name %></a>
            <% }) %>
          </div>
        <% } %>
      </article>
    <% }) %>
  </div>
  <%- paginator({ prev_text: '← 上一页', next_text: '下一页 →' }) %>
</div>
