<article class="post-full">
  <div class="post-full-header">
    <time class="post-date" datetime="<%= date(page.date, 'YYYY-MM-DD') %>">
      <%= date(page.date, 'YYYY 年 MM 月 DD 日') %>
    </time>
    <h1 class="post-full-title"><%= page.title %></h1>
    <% if (page.tags && page.tags.length) { %>
      <div class="post-tags">
        <% page.tags.each(function(tag) { %>
          <a class="tag" href="./<%= tag.path %>"><%= tag.name %></a>
        <% }) %>
      </div>
    <% } %>
  </div>
  <div class="post-content">
    <%- page.content %>
  </div>
  <div class="post-nav">
    <% if (page.prev) { %><a class="prev" href="./<%= page.prev.path %>">← <%= page.prev.title %></a><% } %>
    <% if (page.next) { %><a class="next" href="./<%= page.next.path %>"><%= page.next.title %> →</a><% } %>
  </div>
</article>
